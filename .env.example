# Copy to .env (gitignored) and fill in. docker-compose reads it automatically.
# In production, inject these from your platform's secret store instead of a file.

# HMAC key for signing login tokens. Required: the API will not start without a
# strong value (32+ characters, not a placeholder). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it logs every user out, which is how you rotate a leaked key.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Optional overrides (defaults shown)
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
